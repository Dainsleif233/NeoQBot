# Compose / MUA-Bot
MUA_CONFIG=/app/data/config.yaml
MUA_GUI_BIND_IP=0.0.0.0
MUA_GUI_PORT=6688
# 如果希望由环境变量托管秘密，再取消注释。环境变量优先于 GUI 保存的 YAML。
# MUA_APP__ADMIN_API_TOKEN=replace-with-a-long-random-token
# Compose 默认从持久化文件读取自动生成的 OneBot/NapCat Token；仅外部 NapCat 才需覆盖。
# MUA_QQ__ACCESS_TOKEN=replace-with-onebot-token
# MUA_QQ__WEBUI_TOKEN=replace-with-napcat-webui-token
# MUA_QQ__WEBHOOK_SECRET=replace-with-onebot-webhook-secret
# MUA_LLM__API_KEY=replace-with-agnes-key

# NapCat sidecar。QQ_ACCOUNT 可留空，容器启动后在 MUA-Bot GUI 扫码登录。
QQ_ACCOUNT=
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_WEBUI_BIND_IP=0.0.0.0
NAPCAT_WEBUI_PORT=6099
ONEBOT_HTTP_PORT=6000
NAPCAT_UID=0
NAPCAT_GID=0

# Optional: bake the official Feishu CLI npm package into the image.
INSTALL_FEISHU_CLI=false
FEISHU_CLI_PACKAGE=
