# Compose / NeoQBot
NEOQBOT_CONFIG=/app/data/config.yaml
# 容器内必须监听所有接口；宿主机端口仍默认只绑定 127.0.0.1。
NEOQBOT_APP__HOST=0.0.0.0
NEOQBOT_GUI_BIND_IP=127.0.0.1
NEOQBOT_GUI_PORT=6688
NEOQBOT_APP__ALLOWED_HOSTS=["localhost","127.0.0.1","neoqbot"]
# 如果希望由环境变量托管秘密，再取消注释。环境变量优先于 GUI 保存的 YAML。
# NEOQBOT_APP__ADMIN_API_TOKEN=replace-with-a-long-random-token
# Compose 默认从每个 Bot 配置的持久化 secret 文件读取 OneBot/NapCat Token。
# NEOQBOT_LLM__API_KEY=replace-with-agnes-key

# NapCat sidecar。QQ_ACCOUNT 可留空，容器启动后在 NeoQBot GUI 扫码登录。
QQ_ACCOUNT=
NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
NAPCAT_WEBUI_BIND_IP=127.0.0.1
NAPCAT_WEBUI_PORT=6099
ONEBOT_HTTP_PORT=6000
NAPCAT_UID=0
NAPCAT_GID=0

# Optional: bake the official Feishu CLI npm package into the image.
INSTALL_FEISHU_CLI=false
FEISHU_CLI_PACKAGE=
